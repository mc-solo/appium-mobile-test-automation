# Copy to .env and adjust. Never commit a real .env file.
# Every value below is the safe default; only change what differs
# on your machine or device.

# emulator | real_device
APPIUM_ENV=emulator

# Appium server (start with `appium`)
APPIUM_SERVER_URL=http://127.0.0.1:4723

# Device under test
APPIUM_PLATFORM_NAME=Android
APPIUM_DEVICE_NAME=Android Emulator
APPIUM_PLATFORM_VERSION=14
APPIUM_AUTOMATION_NAME=UiAutomator2

# App under test (ApiDemos)
APPIUM_APP_PACKAGE=io.appium.android.apis
APPIUM_APP_ACTIVITY=.ApiDemos
APPIUM_NO_RESET=false

# Timeouts (seconds)
APPIUM_NEW_COMMAND_TIMEOUT=60
APPIUM_TIMEOUT=10

# Where failure screenshots are saved
APPIUM_SCREENSHOT_DIR=screenshots
